AGENTLAB_LLM_BASE_URL=https://your-openai-compatible-gateway/v1
AGENTLAB_LLM_API_KEY=replace-me
AGENTLAB_DATABASE_URL=postgresql+psycopg://agentlab:agentlab@localhost:5432/agentlab
AGENTLAB_DATA_DIR=.agentlab
AGENTLAB_CONFIG_DIR=config
LITELLM_MASTER_KEY=sk-local-master

# Optional remote embedding override. Empty URL uses local CPU models.
# Ollama needs no API key. Failed remote/local inference falls back to keywords.
AGENTLAB_EMBEDDING_BASE_URL=
AGENTLAB_EMBEDDING_API_KEY=

# Optional, Claude via the native Anthropic Messages API.
AGENTLAB_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
AGENTLAB_ANTHROPIC_API_KEY=
